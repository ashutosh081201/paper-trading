PORT=3000
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stocklab
TOKEN_KEY=<long-random-string>

# ── Email (sign-up OTPs, password reset, alerts) ────────────────
# Production (Render blocks SMTP): Brevo HTTPS API
BREVO_API_KEY=
EMAIL_FROM=<verified-sender@example.com>
# Local alternative: Gmail SMTP with an app password
EMAIL_USER=<you@gmail.com>
EMAIL_PASS=<gmail-app-password>

# ── Optional services ───────────────────────────────────────────
NEWS_API_KEY=
GEMINI_API_KEY=

# Comma-separated origins allowed to call the API (your Vercel URL).
# Leave empty locally to allow any origin.
CORS_ORIGINS=

# Login/signup/OTP attempts allowed per IP per 15 minutes (default 30)
AUTH_RATE_LIMIT_MAX=

# ── Upstox market data ──────────────────────────────────────────
# Option A (recommended): 1-year read-only Analytics Token.
# Upstox Developer Apps → Analytics tab → Generate Token.
UPSTOX_ANALYTICS_TOKEN=

# Option B: daily OAuth login (token expires 3:30 AM IST every day).
# Open http://localhost:3000/api/upstox/login?secret=<UPSTOX_ADMIN_SECRET>
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/upstox/callback
UPSTOX_ADMIN_SECRET=

# Optional: force a provider ("upstox" or "yahoo"). By default Upstox is used
# when a token is available, otherwise Yahoo Finance.
MARKET_DATA_PROVIDER=
